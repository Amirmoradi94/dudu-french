# Copiez ce fichier en « .env » (sur le serveur, ou sur votre ordinateur pour
# essayer en local) et remplissez-le. — Copy this file to .env and fill it in.
# .env n'est jamais versionné (voir .gitignore).

# ---- Le modèle d'IA ----------------------------------------------------
# Clé créée sur https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Le modèle. Quelques options bon marché, prix par million de tokens
# (entrée / sortie), relevés sur openrouter.ai le 12 août 2026 :
#   google/gemini-2.5-flash-lite               0,10  $ / 0,40 $   ← choisi
#   mistralai/mistral-small-3.2-24b-instruct   0,094 $ / 0,25 $   français natif
#   qwen/qwen3.7-flash                         0,03  $ / 0,13 $   ← le moins cher
#   openai/gpt-5-nano                          0,05  $ / 0,40 $
#   anthropic/claude-haiku-4.5                 1,00  $ / 5,00 $   ← le plus soigné
# Une question au tuteur coûte environ 1 000 tokens en entrée et 250 en sortie.
TUTEUR_MODEL=google/gemini-2.5-flash-lite

# Plafond de longueur d'une réponse (protège aussi la facture).
TUTEUR_MAX_TOKENS=700

# ---- Le plafond quotidien (la facture reste prévisible) ------------------
# Réponses du tuteur par personne et par jour : chaque question au tuteur,
# message vocal, exercice oral, réplique de conversation, correction de test
# ou d'atelier compte pour une (une réponse refaite par le serveur compte
# deux). Une fois atteint, le tuteur répond qu'il « se repose jusqu'à
# demain » ; les leçons, exercices et audios marchent toujours.
# Remis à zéro à minuit UTC (20 h à Montréal l'été, 19 h l'hiver). Les compteurs
# sont dans la base SQLite : redémarrer ne les efface pas. 0 = sans limite.
TUTEUR_DAILY_AI_CALLS=150

# Le même plafond pour tout le site réuni, toutes personnes confondues. Avec
# des inscriptions ouvertes, c'est lui qui borne vraiment la facture. Ordre de
# grandeur (octobre 2026) : ~0,001 $ une réponse texte (Claude Haiku 5.5),
# ~0,002 $ un message vocal (Gemini 2.5 Flash) — donc 3000 ≈ 3 à 6 $ / jour au plus.
TUTEUR_DAILY_AI_CALLS_TOTAL=3000

# Les recherches de mots (traduction d'une sélection, phrases d'exemple de
# Mémoire) ont leur propre budget, à part : elles coûtent ~0,0001 $ pièce et
# n'entament jamais les réponses du tuteur. 10000 ≈ 1 $ / jour au plus.
TUTEUR_DAILY_LOOKUPS=300
TUTEUR_DAILY_LOOKUPS_TOTAL=10000
#
# Voir la consommation (par jour, et qui en a fait le plus) :
#     docker compose exec tuteur python3 manage_users.py usage
# Le journal du conteneur (docker compose logs tuteur) affiche aussi le bilan
# de la veille au premier appel de chaque jour, et qui atteint le plafond.

# ---- Facultatif : Claude pour les réponses texte ------------------------
# Avec cette clé (https://console.anthropic.com), les réponses texte du tuteur
# passent par Claude ; l'audio (pratique orale) reste sur OpenRouter.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# TUTEUR_CLAUDE_MODEL=claude-haiku-5-5

# ---- Le contenu du cours -------------------------------------------------
# Le dossier qui contient le cours (leçons, exercices, vocabulaire…), voir
# README.md. Par défaut : l'unité d'exemple de content.sample/.
# CONTENT_DIR=./content

# ---- La pratique orale --------------------------------------------------
# Le modèle pour la pratique orale doit accepter l'audio en entrée — ce n'est
# pas garanti pour n'importe quel modèle mis dans TUTEUR_MODEL ci-dessus, donc
# c'est un réglage séparé. google/gemini-2.5-flash-lite l'accepte nativement
# (0,30 $ / million de tokens audio en entrée — négligeable pour un message
# vocal de quelques secondes). Ne changez que si vous changez aussi de modèle.
# TUTEUR_VOICE_MODEL=google/gemini-2.5-flash-lite

# Les exercices guidés de la section « Parler » (tuiles) : la transcription
# doit garder les fautes de l'élève, et flash-lite « corrige » ce qu'il entend.
# Ce modèle ne sert qu'en secours (navigateur sans reconnaissance vocale) et
# pour l'avis de prononciation.
# TUTEUR_DRILL_MODEL=google/gemini-2.5-flash

# Une réponse vocale contient une transcription ET une correction, donc plus
# longue qu'une réponse texte — plafond séparé de TUTEUR_MAX_TOKENS.
TUTEUR_VOICE_MAX_TOKENS=1000

# ---- Le site -----------------------------------------------------------
# Les conteneurs n'écoutent qu'en local (127.0.0.1:BIND_PORT) : un nginx sur le
# serveur fait le HTTPS et renvoie ici (voir nginx-example.conf).
# En local sur votre ordinateur : http://localhost:8080 (et TUTEUR_COOKIE_SECURE=0 plus bas).
# Ne changez ces deux lignes que si le port 8080 est déjà pris.
SITE_ADDRESS=:80
BIND_PORT=8080

# Sert uniquement à s'identifier auprès d'OpenRouter dans leurs statistiques.
SITE_URL=https://french.example.com

# ---- Les comptes --------------------------------------------------------
# SESSION_SECRET ne se met PAS ici à la main. Sur le serveur, lancez une
# fois :
#     ./set-password.sh
# Cela écrit SESSION_SECRET directement dans ce fichier .env — il sert à
# signer les cookies de session, pour tout le monde.
#
# Chaque personne a ensuite son propre compte (nom d'utilisateur + mot de
# passe), dans une petite base SQLite séparée de .env. Pour en créer un :
#     docker compose exec tuteur python3 manage_users.py add <nom> <mot-de-passe>
# Voir aussi : manage_users.py list / remove <nom>.
#
# Ou bien laissez les gens s'inscrire eux-mêmes sur /signup avec un code
# d'invitation que vous leur donnez. Laissé vide = inscriptions fermées.
# Pour en générer un : python3 -c 'import secrets; print(secrets.token_urlsafe(9))'
# Changer le code n'affecte pas les comptes déjà créés. Après modification :
#     docker compose up -d tuteur
# Lien à envoyer : https://french.example.com/signup?code=<le-code>
SIGNUP_INVITE_CODE=
#
# Ou bien ouvrez les inscriptions à tout le monde, sans code (le code ci-dessus
# est alors ignoré). Une même adresse IP crée au plus 3 comptes par jour.
# Pensez alors à TUTEUR_DAILY_AI_CALLS_TOTAL : plusieurs comptes = plusieurs
# plafonds par personne.
SIGNUP_OPEN=
#
# Le cookie de session est marqué "Secure" par défaut (le VPS n'est servi
# qu'en HTTPS). Pour tester en local sur http://localhost:8080, décommentez :
# TUTEUR_COOKIE_SECURE=0
